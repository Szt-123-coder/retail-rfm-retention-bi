table customers
	lineageTag: 2329a9ef-d612-40f3-ae57-5b9b0ea0148e

	measure 客户数 = COUNTROWS ( customers )
		formatString: #,0
		lineageTag: 51d801f4-0882-42b9-b596-2a1b1b999bb6

	measure 一次性客户占比 = DIVIDE ( CALCULATE ( COUNTROWS ( customers ), customers[F] = 1 ), [客户数] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2727b96c-c2ed-463b-836a-6782116e1842

	measure 按规则流失人数 = CALCULATE ( COUNTROWS ( customers ), customers[churned_by_rule] = TRUE () )
		formatString: 0
		lineageTag: 12267d27-2e8c-4a74-8e52-b77443ba1bc8

	measure 90天回购率 =
			
			CALCULATE (
			    DIVIDE ( SUM ( repurchase[分子] ), SUM ( repurchase[分母] ) ),
			    repurchase[N] = 90,
			    repurchase[预热期（月）] = 1
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 3af734a4-b03e-4fba-902f-1cde16ce676d

	measure 回购率 = DIVIDE ( SUM ( repurchase[分子] ), SUM ( repurchase[分母] ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ed91675a-432b-455d-977a-b1bced04f185

	measure M合计 = SUM ( customers[M] )
		lineageTag: d6cdd268-bcc7-41ae-ba0f-48f00a54e3ae

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure M占比 = DIVIDE ( [M合计], CALCULATE ( [M合计], ALL ( customers[segment], customers[segment_order] ) ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 8924c518-1356-44bd-bb06-3ee43ebb577e

	measure 留存率 = DIVIDE ( SUM ( cohort[active] ), SUM ( cohort[size] ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 4f6cef82-b688-4e7a-a255-1746df0627ab

	measure 迁移人数 = COUNTROWS ( migration )
		formatString: 0
		lineageTag: 92baa18c-abe6-4918-a256-4cc1b20e7016

	measure 迁移占比 = DIVIDE ( [迁移人数], CALCULATE ( [迁移人数], ALLSELECTED ( migration[主窗口分层_显示], migration[主窗口分层排序] ) ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 22640282-25cf-47e7-94fc-7564afca993f

	measure 客户数显示 = FORMAT ( [客户数], "#,0" )
		lineageTag: 3e0d3600-71a5-4da3-86d2-353a274c48da

