	partition customers = m
		mode: import
		source =
				let
				    源 = Csv.Document(File.Contents("D:\AI\求职项目\零售客户分层与留存BI\data\powerbi\customers.csv"),[Delimiter=",", Columns=17, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    提升的标题 = Table.PromoteHeaders(源, [PromoteAllScalars=true]),
				    更改的类型 = Table.TransformColumnTypes(提升的标题,{{"Customer ID", Int64.Type}, {"last_valid_day", type date}, {"F", Int64.Type}, {"R", Int64.Type}, {"M", type number}, {"R_score", Int64.Type}, {"M_score", Int64.Type}, {"F_score", Int64.Type}, {"M_negative", type logical}, {"high_value", type logical}, {"churned_by_rule", type logical}, {"segment", type text}, {"上一年分层", type text}, {"主窗口分层", type text}, {"first_valid_day", type date}, {"客户类型", type text}, {"segment_order", Int64.Type}})
				in
				    更改的类型

